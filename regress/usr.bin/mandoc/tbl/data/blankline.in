.\" $OpenBSD: blankline.in,v 1.3 2026/09/04 13:29:34 schwarze Exp $
.TH TBL-DATA-BLANKLINE 1 "September 4, 2026"
.SH NAME
tbl-data-blankline \- blank lines in a table
.SH DESCRIPTION
completely empty line:
.TS
lb
li
lb.
first

last
.TE
.PP
empty macro line:
.TS
li
lb
li.
first
.
last
.TE
.PP
empty line where the layout contains a horizontal line:
.TS
li
_
li.
first

last
.TE
.PP
empty macro line where the layout contains a horizontal line:
.TS
li
_
li.
first
.
last 1
last 2
.TE
.PP
final text
